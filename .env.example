# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API Keys.
# .env.local is git-ignored. Never use the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Optional, DEV ONLY: the "DEV · Finish game" button on npm run dev works for any account when this matches a key
# in the board_dev_keys table (migration 0027). Any long random text. Never needed for the deployed app.
# VITE_DEV_KEY=
